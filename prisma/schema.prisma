// Prototype uses SQLite (zero setup, file-based).
// For real deployment, switch provider to "postgresql" and point DATABASE_URL
// at a free Postgres instance (Neon, Supabase, Railway) — see README.
datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Letter {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // "COMMIT" | "CONNECT"
  timelineKey    String // "12m" | "3y" | "5y" | "10y" | "20y" | "50y" | "custom"
  targetDate     DateTime
  title          String
  sections       String // JSON-stringified [{ prompt, text }]
  recipientEmail String
  status         String    @default("scheduled") // "draft" | "scheduled" | "sent"
  scheduledAt    DateTime? // when status first became "scheduled" — anchors the edit-lock grace period
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?

  @@index([status, targetDate])
  @@index([userId])
}

// --- Auth.js (NextAuth v5) models, required by the Prisma adapter ---
// Sessions themselves use JWTs (see auth.ts), so the Session model below
// is unused at runtime, but the adapter type still expects it to exist.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  letters       Letter[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

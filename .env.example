# SQLite for local dev. For deployment, swap prisma/schema.prisma's
# provider to "postgresql" and put a hosted Postgres URL here instead
# (e.g. from Neon or Supabase's free tiers).
DATABASE_URL="file:./dev.db"

# Gmail SMTP is the easiest free option for a prototype:
# 1. Turn on 2-Step Verification on the sending Gmail account.
# 2. Create an "App password" at https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below (not your normal password).
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-char-app-password"
EMAIL_FROM="you@gmail.com"

# Any random string. The cron endpoint requires this as a query param
# so randoms on the internet can't trigger it. Generate with e.g.
# `openssl rand -hex 16`.
CRON_SECRET="change-me-to-something-random"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
# Required in production; on localhost NextAuth will generate one for you
# in dev mode but it's better to set it explicitly.
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
